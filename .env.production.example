# =============================================================================
# Agency OS - variables de PRODUCCION (Coolify)
# =============================================================================
# Cargalas en Coolify > recurso > Environment Variables. NO subas un .env real al repositorio.
# Los comentarios van en lineas propias (nunca al lado del valor) para que Coolify no los tome como parte del valor.
#
# [OBLIGATORIA] = el deploy falla con un mensaje claro si falta (docker-compose.yml usa ${VAR:?}).
# [BUILD]       = se hornea en el JS del frontend (VITE_*): el docker-compose.yml la pasa como build arg,
#                 asi que si la cambias hay que REDESPLEGAR (rebuild), no alcanza con reiniciar.

# --- Aplicacion ---------------------------------------------------------------
# [BUILD] tambien se usa como VITE_APP_NAME.
APP_NAME="Agency OS"

# [OBLIGATORIA] Generala UNA sola vez (formato base64:...):
#   docker run --rm laia-agencyos:prod php artisan key:generate --show
# ###########################################################################
# # ADVERTENCIA: GUARDA LA APP_KEY EN UN GESTOR DE CONTRASENAS, FUERA DEL VPS.
# # Si se pierde o se cambia: se pierde PARA SIEMPRE la boveda de credenciales
# # de los clientes, los secretos de Configuracion (SMTP, LaiaTime...) y los
# # secretos de 2FA. No hay forma de recuperarlos. Nunca la rotes sin un plan.
# ###########################################################################
APP_KEY=

# [OBLIGATORIA] Con https y sin barra final; debe coincidir con el dominio asignado en Coolify.
APP_URL=https://agency.tudominio.com
APP_LOCALE=es
APP_FALLBACK_LOCALE=es
TZ=America/Argentina/Buenos_Aires
# stderr: los logs salen por la pestaña Logs de Coolify (no se escriben archivos).
LOG_CHANNEL=stderr
LOG_LEVEL=warning

# Proxies de confianza. "*" confia en cualquiera (Coolify/Traefik esta siempre delante) y es lo que hace falta
# para URLs https y URLs firmadas (invitaciones, presupuestos compartidos). Se puede limitar con IP/CIDR separadas por coma.
TRUSTED_PROXIES=*

# --- Base de datos (PostgreSQL 16, servicio "postgres" del compose) ------------
DB_DATABASE=laia
DB_USERNAME=laia
# [OBLIGATORIA] Contrasena larga y aleatoria, sin espacios ni comillas.
DB_PASSWORD=
# DB_HOST, DB_PORT y DB_CONNECTION los fija el docker-compose (postgres / 5432 / pgsql).

# --- Redis (cache, sesiones, colas, settings) ----------------------------------
# [OBLIGATORIA] Contrasena larga y aleatoria, sin espacios ni comillas.
REDIS_PASSWORD=
# REDIS_HOST, REDIS_PORT, REDIS_CLIENT, CACHE_STORE, SESSION_DRIVER y QUEUE_CONNECTION los fija el docker-compose.
SESSION_LIFETIME=120
# Cookies solo por https (el sitio va por https en Coolify).
SESSION_SECURE_COOKIE=true

# --- Correo --------------------------------------------------------------------
# Resend por SMTP (sin paquete extra): crea una API key en resend.com y verifica el dominio remitente.
# Tambien se puede cargar/pisar desde Configuracion > Correo (SMTP) en el panel (tiene prioridad si esta cargado).
MAIL_MAILER=smtp
MAIL_HOST=smtp.resend.com
# Alternativa: 465 junto con MAIL_SCHEME=smtps
MAIL_PORT=587
MAIL_SCHEME=
MAIL_USERNAME=resend
# Tu API key de Resend (re_xxx).
MAIL_PASSWORD=
# Debe pertenecer a un dominio verificado en Resend.
MAIL_FROM_ADDRESS=hola@laia.studio
MAIL_FROM_NAME="Agency OS"

# --- Tiempo real: Reverb (WebSockets) detras del proxy de Coolify --------------
# Un solo dominio: el navegador conecta por wss://<REVERB_HOST>:443/app/<REVERB_APP_KEY>; nginx (dentro del
# contenedor) lo envia al proceso Reverb (puerto interno 8081, que NO se publica).
# Usa "log" si todavia no activaste el tiempo real.
BROADCAST_CONNECTION=reverb
# Un numero cualquiera, p. ej. 100001.
REVERB_APP_ID=
# [BUILD] Cadena aleatoria publica (queda en el JS). Generala con: openssl rand -hex 16
REVERB_APP_KEY=
# Cadena aleatoria PRIVADA. Generala con: openssl rand -hex 24
REVERB_APP_SECRET=
# [BUILD] El mismo dominio de la app, sin https:// ni puerto.
REVERB_HOST=agency.tudominio.com
# [BUILD]
REVERB_PORT=443
# [BUILD]
REVERB_SCHEME=https
# El frontend recibe VITE_REVERB_APP_KEY / VITE_REVERB_HOST / VITE_REVERB_PORT / VITE_REVERB_SCHEME como build args
# que el compose arma a partir de las REVERB_* de arriba: no hace falta definirlas a mano.
# REVERB_SERVER_HOST=0.0.0.0 y REVERB_SERVER_PORT=8081 los fija el compose (interno).

# --- Procesos del contenedor (Supervisor) --------------------------------------
# Primer deploy: true (migra y siembra roles/permisos). Despues podes volver a false o dejarlo para migrar en cada deploy.
RUN_MIGRATIONS=false
# true/false: apaga los que no deban correr en una replica (el scheduler debe correr en UNA sola).
RUN_QUEUE=true
RUN_SCHEDULER=true
RUN_REVERB=true
QUEUE_WORKERS=1

# --- Backups -------------------------------------------------------------------
# Retencion (dias) de docker/scripts/backup.sh
BACKUP_KEEP_DAYS=14
# Hora local (00-23) del dump diario del servicio "backup".
BACKUP_HOUR=03
